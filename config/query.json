{
  "version": "2.0",
  "name": "首钢会展小镇智慧园区管理系统",
  "database": {
    "type": "Dameng",
    "schema": "FWBZ"
  },
  "tables": {
    "alarm_record": {
      "name": "alarm_record",
      "description": "告警记录表",
      "fields": {
        "id": {"type": "BIGINT", "desc": "主键ID"},
        "device_id": {"type": "BIGINT", "desc": "设备ID", "filterable": true},
        "device_name": {"type": "VARCHAR(255)", "desc": "设备名称"},
        "space_id": {"type": "BIGINT", "desc": "空间ID"},
        "space_name": {"type": "VARCHAR(255)", "desc": "空间名称"},
        "alarm_rule_id": {"type": "BIGINT", "desc": "告警规则ID"},
        "alarm_content": {"type": "TEXT", "desc": "告警内容"},
        "alarm_time": {"type": "TIMESTAMP", "desc": "告警时间", "filterable": true},
        "alarm_category_id": {"type": "BIGINT", "desc": "告警类别ID"},
        "alarm_category_name": {"type": "VARCHAR(255)", "desc": "告警类别名称"},
        "alarm_level_id": {"type": "BIGINT", "desc": "告警级别ID"},
        "alarm_level_name": {"type": "VARCHAR(255)", "desc": "告警级别名称"},
        "alarm_level_color": {"type": "VARCHAR(50)", "desc": "告警级别颜色"},
        "charge_person": {"type": "BIGINT", "desc": "负责人ID"},
        "charge_person_name": {"type": "VARCHAR(255)", "desc": "负责人名称"},
        "alarm_status": {"type": "VARCHAR(1)", "desc": "告警状态【1-未处理，2-已消除】"},
        "point_id": {"type": "BIGINT", "desc": "点位ID"},
        "point_name": {"type": "VARCHAR(255)", "desc": "点位名称"},
        "value": {"type": "VARCHAR(255)", "desc": "告警值"},
        "condition_value": {"type": "VARCHAR(255)", "desc": "阈值"},
        "operator": {"type": "VARCHAR(255)", "desc": "条件运算符"},
        "time_granularity": {"type": "VARCHAR(255)", "desc": "时间粒度"},
        "alarm_rule_point_id": {"type": "BIGINT", "desc": "告警规则点位ID"},
        "device_category_id": {"type": "BIGINT", "desc": "设备类别ID"},
        "event_id": {"type": "VARCHAR(50)", "desc": "事件ID"},
        "process_time": {"type": "TIMESTAMP(6)", "desc": "处理时间"}
      }
    },
    "alarm_category": {
      "name": "alarm_category",
      "description": "报警类别表",
      "fields": {
        "id": {"type": "BIGINT", "desc": "主键ID"},
        "alarm_category_name": {"type": "VARCHAR(255)", "desc": "类别名称"},
        "alarm_category_code": {"type": "VARCHAR(255)", "desc": "类别编号"},
        "sort": {"type": "INT", "desc": "排序字段"},
        "status": {"type": "VARCHAR(2)", "desc": "状态。启用：1；禁用：0"}
      }
    },
    "alarm_level": {
      "name": "alarm_level",
      "description": "报警级别表",
      "fields": {
        "id": {"type": "BIGINT", "desc": "主键ID"},
        "alarm_level_code": {"type": "VARCHAR(255)", "desc": "等级编号"},
        "alarm_level_name": {"type": "VARCHAR(255)", "desc": "等级名称"},
        "alarm_level_color": {"type": "VARCHAR(50)", "desc": "告警颜色"},
        "sort": {"type": "INT", "desc": "排序字段"},
        "status": {"type": "VARCHAR(2)", "desc": "状态。启用：1；禁用：0"}
      }
    },
    "alarm_rules": {
      "name": "alarm_rules",
      "description": "告警规则表",
      "fields": {
        "id": {"type": "BIGINT", "desc": "主键ID"},
        "rule_code": {"type": "VARCHAR(255)", "desc": "规则编号"},
        "rule_name": {"type": "VARCHAR(255)", "desc": "规则名称"},
        "alarm_category_id": {"type": "BIGINT", "desc": "报警类别ID"},
        "alarm_category_name": {"type": "VARCHAR(255)", "desc": "报警类别名称"},
        "alarm_level_id": {"type": "BIGINT", "desc": "报警等级ID"},
        "alarm_level_name": {"type": "VARCHAR(255)", "desc": "报警级别名称"},
        "alarm_level_color": {"type": "VARCHAR(50)", "desc": "报警颜色"},
        "frequency": {"type": "INT", "desc": "频率"},
        "frequency_unit": {"type": "VARCHAR(50)", "desc": "频率单位"},
        "point_type": {"type": "VARCHAR(50)", "desc": "报警点位类型（instant/accumulate）"},
        "enabled_status": {"type": "VARCHAR(2)", "desc": "启用状态【0-禁用，1-启用】"}
      }
    },
    "alarm_rule_point": {
      "name": "alarm_rule_point",
      "description": "告警规则设备点位配置表",
      "fields": {
        "id": {"type": "BIGINT", "desc": "主键ID"},
        "alarm_rule_id": {"type": "BIGINT", "desc": "告警规则ID"},
        "device_id": {"type": "BIGINT", "desc": "设备ID"},
        "device_name": {"type": "VARCHAR(255)", "desc": "设备名称"},
        "point_id": {"type": "BIGINT", "desc": "点位ID"},
        "point_name": {"type": "VARCHAR(255)", "desc": "点位名称"},
        "time_granularity": {"type": "VARCHAR(50)", "desc": "时间粒度（hour/day/month/year）"},
        "operator": {"type": "VARCHAR(10)", "desc": "条件运算符（如 >, <, = 等）"},
        "condition_value": {"type": "VARCHAR(255)", "desc": "条件值"}
      }
    },
    "device": {
      "name": "device",
      "description": "设备基础信息",
      "fields": {
        "id": {"type": "BIGINT", "desc": "主键ID"},
        "device_code": {"type": "VARCHAR(255)", "desc": "设备编号"},
        "device_name": {"type": "VARCHAR(255)", "desc": "设备名称"},
        "category_id": {"type": "BIGINT", "desc": "设备类别id"},
        "space_id": {"type": "BIGINT", "desc": "空间位置id"},
        "magnification": {"type": "DECIMAL(19,4)", "desc": "倍率"},
        "automatic_algorithm": {"type": "VARCHAR(255)", "desc": "自动算法"},
        "model_id": {"type": "BIGINT", "desc": "设备模型id"},
        "run_state": {"type": "VARCHAR(255)", "desc": "运行状态"},
        "device_type": {"type": "VARCHAR(2)", "desc": "设备分类。仪表：1；设备：2"},
        "last_gather_time": {"type": "TIMESTAMP", "desc": "最后采集时间"},
        "venue_id": {"type": "BIGINT", "desc": "场馆id"}
      }
    },
    "device_attribute": {
      "name": "device_attribute",
      "description": "设备属性信息",
      "fields": {
        "id": {"type": "BIGINT", "desc": "主键ID"},
        "device_id": {"type": "BIGINT", "desc": "设备ID"},
        "attribute_name": {"type": "VARCHAR(255)", "desc": "属性名称"},
        "attribute_code": {"type": "VARCHAR(255)", "desc": "属性编码"},
        "unit": {"type": "VARCHAR(255)", "desc": "单位"},
        "value": {"type": "DECIMAL(19,4)", "desc": "采集值"},
        "gather_time": {"type": "TIMESTAMP", "desc": "采集时间"},
        "value_type": {"type": "VARCHAR(50)", "desc": "属性值类型"}
      }
    },
    "device_model": {
      "name": "device_model",
      "description": "设备模型",
      "fields": {
        "id": {"type": "BIGINT", "desc": "主键ID"},
        "model_name": {"type": "VARCHAR(255)", "desc": "模型名称"},
        "category_id": {"type": "BIGINT", "desc": "专业id"}
      }
    },
    "device_model_attribute": {
      "name": "device_model_attribute",
      "description": "设备模型属性",
      "fields": {
        "id": {"type": "BIGINT", "desc": "主键ID"},
        "model_id": {"type": "BIGINT", "desc": "模型id"},
        "attribute_name": {"type": "VARCHAR(255)", "desc": "属性名称"},
        "attribute_code": {"type": "VARCHAR(255)", "desc": "属性编码"},
        "unit": {"type": "VARCHAR(255)", "desc": "单位"},
        "value_type": {"type": "VARCHAR(50)", "desc": "属性值类型"}
      }
    },
    "space": {
      "name": "space",
      "description": "空间位置表",
      "fields": {
        "id": {"type": "BIGINT", "desc": "主键ID"},
        "pid": {"type": "BIGINT", "desc": "父级节点"},
        "has_child": {"type": "VARCHAR(10)", "desc": "是否有子节点"},
        "space_name": {"type": "VARCHAR(255)", "desc": "空间名称"},
        "full_name": {"type": "VARCHAR(255)", "desc": "空间全称"},
        "full_id": {"type": "VARCHAR(255)", "desc": "父级id"},
        "sort": {"type": "INT", "desc": "排序字段"}
      }
    },
    "equipment_category": {
      "name": "equipment_category",
      "description": "设备类别表",
      "fields": {
        "id": {"type": "BIGINT", "desc": "主键ID"},
        "pid": {"type": "BIGINT", "desc": "父级节点"},
        "has_child": {"type": "VARCHAR(10)", "desc": "是否有子节点"},
        "category_name": {"type": "VARCHAR(255)", "desc": "类别名称"},
        "full_name": {"type": "VARCHAR(255)", "desc": "全称"},
        "type": {"type": "VARCHAR(2)", "desc": "分类。仪表：1；设备：2"}
      }
    },
    "data_day": {
      "name": "data_day",
      "description": "日能耗数据",
      "fields": {
        "id": {"type": "BIGINT", "desc": "主键ID"},
        "device_id": {"type": "BIGINT", "desc": "设备id", "filterable": true},
        "value": {"type": "DECIMAL(38,4)", "desc": "数值"},
        "time": {"type": "TIMESTAMP", "desc": "时间", "filterable": true}
      }
    },
    "data_hour": {
      "name": "data_hour",
      "description": "小时能耗数据",
      "fields": {
        "id": {"type": "BIGINT", "desc": "主键ID"},
        "device_id": {"type": "BIGINT", "desc": "设备id", "filterable": true},
        "value": {"type": "DECIMAL(38,4)", "desc": "数值"},
        "start_value": {"type": "DECIMAL(38,4)", "desc": "起始值"},
        "end_value": {"type": "DECIMAL(38,4)", "desc": "结束值"},
        "compute_value": {"type": "DECIMAL(38,4)", "desc": "计算值"},
        "time": {"type": "TIMESTAMP", "desc": "时间", "filterable": true}
      }
    },
    "data_minute": {
      "name": "data_minute",
      "description": "分钟能耗数据",
      "fields": {
        "id": {"type": "BIGINT", "desc": "主键ID"},
        "device_id": {"type": "BIGINT", "desc": "设备id", "filterable": true},
        "start_value": {"type": "DECIMAL(19,2)", "desc": "起始值"},
        "end_value": {"type": "DECIMAL(19,2)", "desc": "结束值"},
        "value": {"type": "DECIMAL(10,2)", "desc": "数值"},
        "time": {"type": "TIMESTAMP", "desc": "时间", "filterable": true}
      }
    },
    "data_month": {
      "name": "data_month",
      "description": "月能耗数据",
      "fields": {
        "id": {"type": "BIGINT", "desc": "主键ID"},
        "device_id": {"type": "BIGINT", "desc": "设备id", "filterable": true},
        "value": {"type": "DECIMAL(38,4)", "desc": "数值"},
        "time": {"type": "TIMESTAMP", "desc": "时间", "filterable": true}
      }
    },
    "data_year": {
      "name": "data_year",
      "description": "年能耗数据",
      "fields": {
        "id": {"type": "BIGINT", "desc": "主键ID"},
        "device_id": {"type": "BIGINT", "desc": "设备id", "filterable": true},
        "value": {"type": "DECIMAL(38,4)", "desc": "数值"},
        "time": {"type": "TIMESTAMP", "desc": "时间", "filterable": true}
      }
    },
    "data_real": {
      "name": "data_real",
      "description": "实时能耗数据",
      "fields": {
        "id": {"type": "BIGINT", "desc": "主键ID"},
        "device_id": {"type": "BIGINT", "desc": "设备id"},
        "value": {"type": "DECIMAL(38,4)", "desc": "数值"},
        "time": {"type": "TIMESTAMP", "desc": "时间"}
      }
    },
    "metering_point": {
      "name": "metering_point",
      "description": "计量点位配置表",
      "fields": {
        "id": {"type": "BIGINT", "desc": "主键ID"},
        "type": {"type": "VARCHAR(255)", "desc": "类型"},
        "node_code": {"type": "VARCHAR(255)", "desc": "节点编号"},
        "node_name": {"type": "VARCHAR(255)", "desc": "节点名称"},
        "parent_id": {"type": "BIGINT", "desc": "父节点ID"},
        "category_id": {"type": "BIGINT", "desc": "设备类别"},
        "space_id": {"type": "BIGINT", "desc": "空间位置"},
        "formula": {"type": "TEXT", "desc": "公式"}
      }
    },
    "metering_point_data_day": {
      "name": "metering_point_data_day",
