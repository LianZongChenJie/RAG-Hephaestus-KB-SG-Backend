{
  "version": "2.0",
  "name": "首钢会展小镇智慧园区管理系统",
  "database": {
    "type": "Dameng",
    "schema": "FWBZ"
  },
  "tables": {
    "alarm_record": {
      "name": "alarm_record",
      "description": "告警记录表",
      "fields": {
        "id": {"type": "BIGINT", "desc": "主键ID"},
        "device_id": {"type": "BIGINT", "desc": "设备ID", "filterable": true},
        "device_name": {"type": "VARCHAR(255)", "desc": "设备名称"},
        "space_id": {"type": "BIGINT", "desc": "空间ID"},
        "space_name": {"type": "VARCHAR(255)", "desc": "空间名称"},
        "alarm_content": {"type": "TEXT", "desc": "告警内容"},
        "alarm_time": {"type": "TIMESTAMP", "desc": "告警时间", "filterable": true},
        "alarm_category_id": {"type": "BIGINT", "desc": "告警类别ID"},
        "alarm_category_name": {"type": "VARCHAR(255)", "desc": "告警类别名称"},
        "alarm_level_id": {"type": "BIGINT", "desc": "告警级别ID"},
        "alarm_level_name": {"type": "VARCHAR(255)", "desc": "告警级别名称"},
        "charge_person_name": {"type": "VARCHAR(255)", "desc": "负责人名称"},
        "alarm_status": {"type": "VARCHAR(1)", "desc": "告警状态【1-未处理，2-已消除】"},
        "point_name": {"type": "VARCHAR(255)", "desc": "点位名称"},
        "value": {"type": "VARCHAR(255)", "desc": "告警值"},
        "condition_value": {"type": "VARCHAR(255)", "desc": "阈值"}
      }
    },
    "device": {
      "name": "device",
      "description": "设备基础信息",
      "fields": {
        "id": {"type": "BIGINT", "desc": "主键ID"},
        "device_code": {"type": "VARCHAR(255)", "desc": "设备编号"},
        "device_name": {"type": "VARCHAR(255)", "desc": "设备名称"},
        "category_id": {"type": "BIGINT", "desc": "设备类别id"},
        "space_id": {"type": "BIGINT", "desc": "空间位置id"},
        "run_state": {"type": "VARCHAR(255)", "desc": "运行状态"},
        "device_type": {"type": "VARCHAR(2)", "desc": "设备分类。仪表：1；设备：2"},
        "last_gather_time": {"type": "TIMESTAMP", "desc": "最后采集时间"},
        "venue_id": {"type": "BIGINT", "desc": "场馆id"}
      }
    },
    "data_day": {
      "name": "data_day",
      "description": "日数据",
      "fields": {
        "id": {"type": "BIGINT", "desc": "主键ID"},
        "device_id": {"type": "BIGINT", "desc": "设备id", "filterable": true},
        "value": {"type": "DECIMAL(38,4)", "desc": "数值"},
        "time": {"type": "TIMESTAMP", "desc": "时间", "filterable": true}
      }
    },
    "table_venue_flow": {
      "name": "table_venue_flow",
      "description": "各场馆客流统计",
      "fields": {
        "id": {"type": "BIGINT", "desc": "主键ID"},
        "data_date": {"type": "DATE", "desc": "统计日期"},
        "venue_id": {"type": "BIGINT", "desc": "场馆id", "filterable": true},
        "today_in_count": {"type": "BIGINT", "desc": "进场人数"},
        "today_now_count": {"type": "BIGINT", "desc": "在场人数"},
        "max_count": {"type": "BIGINT", "desc": "峰值人数"},
        "max_time": {"type": "TIME", "desc": "峰值时间"},
        "average_duration": {"type": "DOUBLE", "desc": "平均时长"}
      }
    },
    "table_venue_info": {
      "name": "table_venue_info",
      "description": "场馆基本信息",
      "fields": {
        "id": {"type": "BIGINT", "desc": "主键ID"},
        "venue_name": {"type": "VARCHAR2(50)", "desc": "场馆名称"},
        "location": {"type": "VARCHAR2(50)", "desc": "位置"},
        "area": {"type": "VARCHAR2(20)", "desc": "建筑面积"},
        "floors": {"type": "BIGINT", "desc": "楼层"}
      }
    },
    "table_activeMeet_info": {
      "name": "table_activeMeet_info",
      "description": "展会活动信息",
      "fields": {
        "id": {"type": "BIGINT", "desc": "主键ID"},
        "active_name": {"type": "VARCHAR2(255)", "desc": "展会名称"},
        "venue_id": {"type": "BIGINT", "desc": "场馆id"},
        "venue_floors": {"type": "VARCHAR2(255)", "desc": "展会层数"},
        "start_date": {"type": "DATE", "desc": "开始日期"},
        "start_time": {"type": "TIME", "desc": "开始时间"},
        "end_time": {"type": "TIME", "desc": "结束时间"},
        "people_quantity": {"type": "BIGINT", "desc": "预计人数"}
      }
    },
    "table_personnel_statistics": {
      "name": "table_personnel_statistics",
      "description": "人员统计表",
      "fields": {
        "id": {"type": "BIGINT", "desc": "主键ID"},
        "stat_date": {"type": "DATE", "desc": "统计日期"},
        "today_entry_count": {"type": "BIGINT", "desc": "今日进场人数"},
        "current_in_count": {"type": "BIGINT", "desc": "当前在场人数"},
        "recognition_record_count": {"type": "BIGINT", "desc": "人员识别记录数"},
        "abnormal_warning_count": {"type": "BIGINT", "desc": "异常行为预警数"}
      }
    }
  }
}
