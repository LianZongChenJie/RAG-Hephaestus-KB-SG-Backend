        "status": {"type": "TINYINT", "desc": "状态，0：未完成，1：已完成"},
        "complete_time": {"type": "DATETIME(6)", "desc": "完成时间"}
      }
    },
    "table_activeMeet_preparation_type": {
      "name": "table_activeMeet_preparation_type",
