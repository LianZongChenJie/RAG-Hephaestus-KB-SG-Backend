        "id": {"type": "BIGINT", "desc": "主键ID"},
        "metering_point_id": {"type": "BIGINT", "desc": "计量点位ID"},
        "value": {"type": "DECIMAL(30,4)", "desc": "数值"},
        "time": {"type": "TIMESTAMP", "desc": "时间", "filterable": true}
      }
    },
    "energy_price": {
      "name": "energy_price",
      "description": "能源单价配置表",
      "fields": {
        "id": {"type": "VARCHAR(36)", "desc": "主键ID"},
        "energy_medium": {"type": "VARCHAR(32)", "desc": "能源介质"},
        "unit_price": {"type": "DECIMAL(10,5)", "desc": "单价"},
        "unit": {"type": "VARCHAR(32)", "desc": "单位"}
      }
    },
    "energy_medium_manage": {
      "name": "energy_medium_manage",
      "description": "能介管理表",
      "fields": {
        "id": {"type": "BIGINT", "desc": "主键ID"},
        "pid": {"type": "BIGINT", "desc": "父级节点"},
        "code": {"type": "VARCHAR(255)", "desc": "能介编码"},
        "name": {"type": "VARCHAR(255)", "desc": "能介名称"},
        "standard_unit": {"type": "BIGINT", "desc": "标准单位"},
        "sort": {"type": "INT", "desc": "排序"}
      }
    },
    "carbon_emission_factor": {
      "name": "carbon_emission_factor",
      "description": "碳排放因子表",
      "fields": {
        "id": {"type": "VARCHAR(36)", "desc": "主键ID"},
        "carbon_factor_name": {"type": "VARCHAR(32)", "desc": "碳因子名称"},
        "coefficient": {"type": "VARCHAR(32)", "desc": "系数"},
        "unit": {"type": "VARCHAR(32)", "desc": "单位"}
      }
    },
    "table_venue_info": {
      "name": "table_venue_info",
      "description": "场馆基本信息",
      "fields": {
        "id": {"type": "BIGINT", "desc": "主键ID"},
        "venue_name": {"type": "VARCHAR(50)", "desc": "场馆名称"},
        "location": {"type": "VARCHAR(50)", "desc": "位置"},
        "orientation": {"type": "VARCHAR(20)", "desc": "朝向"},
