            INNER JOIN FWBZ."equipment_category" ec ON d."category_id" = ec."id"
            WHERE dd."time" >= TO_DATE('2026-09-11', 'YYYY-MM-DD')
            AND dd."time" < TO_DATE('2026-09-12', 'YYYY-MM-DD')
